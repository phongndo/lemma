{
  "name": "@lemma/profiles-switcher",
  "version": "0.1.0",
  "private": true,
  "description": "The profiles on this machine: listed, opened (their host started when none runs), and made; the web half switches between them once there is more than one",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web.tsx"
  },
  "scripts": {
    "check": "tsrs --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lemma/contracts": "workspace:*",
    "@lemma/core": "workspace:*",
    "@lemma/look": "workspace:*",
    "@lemma/profiles": "workspace:*",
    "@lemma/settings": "workspace:*",
    "@lemma/web": "workspace:*",
    "effect": "4.0.5",
    "solid-js": "1.9.17"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vitest": "5.0.5"
  },
  "lemma": {
    "host": "./src/index.ts",
    "web": "./src/web.tsx"
  }
}
