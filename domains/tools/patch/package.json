{
  "name": "@lemma/tools-patch",
  "version": "0.1.0",
  "private": true,
  "description": "The `apply_patch` tool: Codex's patch format, adding, deleting, updating, and moving files together or not at all, with unified diffs",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./web": "./src/web.ts"
  },
  "scripts": {
    "check": "tsrs --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lemma/agent": "workspace:*",
    "@lemma/core": "workspace:*",
    "@lemma/threads": "workspace:*",
    "@lemma/tools": "workspace:*",
    "@lemma/web": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "vitest": "5.0.5"
  },
  "lemma": {
    "host": "./src/index.ts",
    "web": "./src/web.ts"
  }
}
