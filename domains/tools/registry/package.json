{
  "name": "@lemma/tools-registry",
  "version": "0.1.0",
  "private": true,
  "description": "Lists and runs the tools plugins add, checked by their guards",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lemma/contracts": "workspace:*",
    "@lemma/core": "workspace:*",
    "@lemma/llm": "workspace:*",
    "@lemma/tools": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@lemma/testing": "workspace:*",
    "@lemma/tools-bash": "workspace:*",
    "@lemma/tools-edit": "workspace:*",
    "@lemma/tools-patch": "workspace:*",
    "@lemma/tools-read": "workspace:*",
    "@lemma/tools-write": "workspace:*",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "lemma": {
    "host": "./src/index.ts"
  }
}
