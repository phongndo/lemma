{
  "name": "@lemma/example-budget",
  "version": "0.1.0",
  "private": true,
  "description": "A token budget for each turn, and a meter: observes the agent's turns and its tools' results, wraps each model call, and has a say in whether a turn goes on",
  "type": "module",
  "scripts": {
    "check": "tsrs --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lemma/agent": "workspace:*",
    "@lemma/contracts": "workspace:*",
    "@lemma/core": "workspace:*",
    "@lemma/llm": "workspace:*",
    "@lemma/tools": "workspace:*",
    "effect": "4.1.6"
  },
  "devDependencies": {
    "@lemma/agent-loop": "workspace:*",
    "@lemma/sessions": "workspace:*",
    "@lemma/sessions-files": "workspace:*",
    "@lemma/tools-registry": "workspace:*",
    "@types/node": "24.19.4",
    "tsrs": "7.1.0-beta.tsrs5",
    "vitest": "5.1.2"
  },
  "lemma": {
    "host": "./budget.ts"
  }
}
