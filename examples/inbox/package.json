{
  "name": "@lemma/example-inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Inbox triage: new messages reach the model as context events, two tools read and file them, and a profile narrows the agent to them",
  "type": "module",
  "scripts": {
    "check": "tsrs --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lemma/agent": "workspace:*",
    "@lemma/core": "workspace:*",
    "@lemma/sessions": "workspace:*",
    "@lemma/tools": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@lemma/agent-loop": "workspace:*",
    "@lemma/agent-profiles": "workspace:*",
    "@lemma/contracts": "workspace:*",
    "@lemma/llm": "workspace:*",
    "@lemma/sessions-files": "workspace:*",
    "@lemma/tools-registry": "workspace:*",
    "@types/node": "24.19.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vitest": "5.0.5"
  },
  "lemma": {
    "host": "./inbox.ts",
    "resources": {
      "profiles": "./profiles"
    }
  }
}
