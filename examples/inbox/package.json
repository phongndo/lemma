{
  "name": "@lemma/example-inbox",
  "version": "0.1.0",
  "private": true,
  "description": "Inbox triage: new messages reach the model as context events, two tools read and file them, and a mode narrows the agent to them",
  "type": "module",
  "scripts": {
    "check": "tsrs --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lemma/agent": "workspace:*",
    "@lemma/core": "workspace:*",
    "@lemma/sessions": "workspace:*",
    "@lemma/tools": "workspace:*",
    "effect": "4.1.6"
  },
  "devDependencies": {
    "@lemma/agent-loop": "workspace:*",
    "@lemma/agent-modes": "workspace:*",
    "@lemma/contracts": "workspace:*",
    "@lemma/llm": "workspace:*",
    "@lemma/sessions-files": "workspace:*",
    "@lemma/tools-registry": "workspace:*",
    "@types/node": "24.19.4",
    "tsrs": "7.1.0-beta.tsrs5",
    "vitest": "5.1.2"
  },
  "lemma": {
    "host": "./inbox.ts",
    "resources": {
      "modes": "./modes"
    }
  }
}
