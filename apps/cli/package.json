{
  "name": "@lemma/cli-app",
  "version": "0.2.0",
  "private": true,
  "description": "The lemma command: start and keep hosts, set them up, look inside them, and use what their plugins add",
  "bin": {
    "lemma": "./bin/lemma.js"
  },
  "type": "module",
  "scripts": {
    "check": "tsrs --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.ts"
  },
  "dependencies": {
    "@lemma/cli": "workspace:*",
    "@lemma/client": "workspace:*",
    "@lemma/contracts": "workspace:*",
    "@lemma/host": "workspace:*",
    "@lemma/profiles": "workspace:*",
    "@lemma/release": "workspace:*",
    "effect": "4.0.5",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "vitest": "5.0.5"
  }
}
