                  { "required": ["signal", "until_prompt"] },
                  { "required": ["contains", "until_prompt"] }
                ]
              }
            },
            {
              "if": { "required": ["after_generation"] },
              "then": { "anyOf": [{ "required": ["contains"] }, { "required": ["until_prompt"] }] }
            }
