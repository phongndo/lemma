    "procedure": {
      "title": "Lemma Proc v1",
      "type": "object",
      "required": ["schema", "actions"],
      "properties": {
        "schema": { "const": "lemma.proc/v1" },
        "on_error": { "enum": ["stop", "continue"], "default": "stop" },
        "actions": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/procedureAction" }
        }
      },
      "additionalProperties": false
    },
    "procedureResult": {
      "title": "Lemma Proc result v1",
      "type": "object",
      "required": ["schema", "ok", "results"],
      "properties": {
        "schema": { "const": "lemma.proc-result/v1" },
        "ok": { "type": "boolean" },
        "partial": { "type": "boolean" },
        "results": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": ["index", "result"],
            "properties": {
              "index": { "type": "integer", "minimum": 0, "maximum": 63 },
              "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,32}$" },
              "result": { "$ref": "#/$defs/actionResult" }
            },
            "additionalProperties": false
          }
        },
        "error": { "type": "object" }
      },
      "additionalProperties": false
    },
    "subscription": {
      "title": "Lemma Event subscription v1",
      "type": "object",
      "required": ["schema"],
      "properties": {
        "schema": { "const": "lemma.events/v1" },
        "session": { "$ref": "#/$defs/sessionSelector" },
        "pane": { "$ref": "#/$defs/paneSelector" },
        "panes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/paneSelector" }
        },
        "screen": { "type": "boolean", "default": false }
      },
      "dependentRequired": { "pane": ["session"], "panes": ["session"] },
      "allOf": [
        {
          "not": { "required": ["pane", "panes"] }
        },
        {
          "if": { "required": ["screen"], "properties": { "screen": { "const": true } } },
          "then": { "anyOf": [{ "required": ["pane"] }, { "required": ["panes"] }] }
        }
      ],
      "additionalProperties": false
    },
    "observedPane": {
      "type": "object",
      "required": ["pane", "present"],
      "properties": {
        "session": { "$ref": "#/$defs/id" },
        "pane": { "$ref": "#/$defs/id" },
        "present": { "type": "boolean" },
        "generation": { "type": "integer", "minimum": 1 },
        "process": { "$ref": "#/$defs/eventProcess" }
      },
      "additionalProperties": false
    },
    "event": {
      "title": "Lemma Event v1",
      "type": "object",
      "required": ["schema", "sequence", "event"],
      "properties": {
        "schema": { "const": "lemma.event/v1" },
        "sequence": { "type": "integer", "minimum": 0 },
        "event": { "enum": ["snapshot", "state.changed", "pane.terminal", "pane.screen", "pane.process", "pane.closed"] },
        "sessions": { "type": "array" },
        "session": { "$ref": "#/$defs/id" },
        "pane": { "$ref": "#/$defs/id" },
        "panes": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/observedPane" }
        },
        "present": { "type": "boolean" },
        "generation": { "type": "integer", "minimum": 1 },
        "revision": { "type": "integer", "minimum": 1 },
        "cursor_at_prompt": { "type": "boolean" },
        "changed": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["screen", "cursor", "prompt", "title", "pwd"] }
        },
        "text": { "type": "string" },
        "capture": { "$ref": "#/$defs/capture" },
        "process": { "$ref": "#/$defs/eventProcess" }
      },
      "additionalProperties": false
    }
  }
}
