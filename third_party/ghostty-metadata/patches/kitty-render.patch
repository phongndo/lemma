+#ifndef GHOSTTY_VT_KITTY_RENDER_H
+#define GHOSTTY_VT_KITTY_RENDER_H
+
+#include <ghostty/vt/terminal.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Viewport projection using native placement/placeholder/parent-chain semantics.
+ * Pixels remain accessible through the existing image API. All views are invalid
+ * after a terminal mutation. No pixels or borrowed pointers are retained here. */
+typedef struct {
+  uint32_t image_id;
+  int32_t column, row;
+  uint32_t offset_x, offset_y;
+  uint32_t pixel_width, pixel_height;
+  uint32_t source_x, source_y, source_width, source_height;
+  int32_t z;
+} GhosttyKittyRenderPlacement;
+
+/* Bounded to 1024 stored placements/images and 16384 projection operations.
+ * On failure the output is not publishable. count is set only on success. */
+GhosttyResult ghostty_terminal_kitty_render(GhosttyTerminal terminal,
+    GhosttyKittyRenderPlacement* output, size_t capacity, size_t* count);
+
+/* Caller-owned monotonic milliseconds. SUCCESS returns the next delay;
+ * NO_VALUE means no animation needs a timer. Tick only while presenting this
+ * terminal. Native image generations change when the displayed pixels change. */
+GhosttyResult ghostty_terminal_kitty_tick(GhosttyTerminal terminal,
+    uint64_t now_ms, uint64_t* delay_ms);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
