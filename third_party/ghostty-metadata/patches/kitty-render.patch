diff --git b/src/terminal/c/kitty_render.zig b/src/terminal/c/kitty_render.zig
new file mode 100644
index 0000000..04ef5e4
--- /dev/null
+++ b/src/terminal/c/kitty_render.zig
@@ -0,0 +1,188 @@
+//! Bounded native graphics projection for non-GPU embedders.
+const std = @import("std");
+const options = @import("terminal_options");
+const lib = @import("../lib.zig");
+const tc = @import("terminal.zig");
+const graphics = @import("kitty_graphics.zig");
+const unicode = @import("../kitty/graphics_unicode.zig");
+const Storage = @import("../kitty/graphics_storage.zig").ImageStorage;
+const Image = @import("../kitty/graphics_image.zig").Image;
+const Terminal = @import("../Terminal.zig");
+const Result = @import("result.zig").Result;
+
+pub const RenderPlacement = extern struct {
+    image_id: u32,
+    column: i32,
+    row: i32,
+    offset_x: u32,
+    offset_y: u32,
+    pixel_width: u32,
+    pixel_height: u32,
+    source_x: u32,
+    source_y: u32,
+    source_width: u32,
+    source_height: u32,
+    z: i32,
+};
+
+const limit = 1024;
+const Origin = struct { key: Storage.PlacementKey, x: u32, y: u32 };
+
+fn regular(t: *Terminal, p: *const Storage.Placement, image: *const Image) RenderPlacement {
+    const ps = p.pixelSize(image.*, t);
+    const source = p.sourceRect(image.*);
+    return .{
+        .image_id = image.id,
+        .column = 0,
+        .row = 0,
+        .offset_x = @min(p.x_offset, t.width_px / t.cols -| 1),
+        .offset_y = @min(p.y_offset, t.height_px / t.rows -| 1),
+        .pixel_width = ps.width,
+        .pixel_height = ps.height,
+        .source_x = source.x,
+        .source_y = source.y,
+        .source_width = source.width,
+        .source_height = source.height,
+        .z = p.z,
+    };
+}
+
+fn visible(t: *Terminal, value: RenderPlacement) bool {
+    const cw = t.width_px / t.cols;
+    const ch = t.height_px / t.rows;
+    const x = @as(i64, value.column) * cw + value.offset_x;
+    const y = @as(i64, value.row) * ch + value.offset_y;
+    return value.pixel_width > 0 and value.pixel_height > 0 and
+        x < t.width_px and y < t.height_px and
+        x + value.pixel_width > 0 and y + value.pixel_height > 0;
+}
+
+pub fn render(terminal_: tc.Terminal, output_: ?[*]RenderPlacement, capacity: usize, count_: ?*usize) callconv(lib.calling_conv) Result {
+    if (comptime !options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const count = count_ orelse return .invalid_value;
+    if (capacity > limit) return .limit_exceeded;
+    const output: []RenderPlacement = if (capacity == 0) &.{} else (output_ orelse return .invalid_value)[0..capacity];
+    const t = wrapper.terminal;
+    if (t.width_px < t.cols or t.height_px < t.rows) return .invalid_value;
+    const storage = &t.screens.active.kitty_images;
+    if (storage.placements.count() > limit or storage.images.count() > limit) return .limit_exceeded;
+    var used: usize = 0;
+    var has_virtual = false;
+    var has_relative = false;
+    var budget: usize = 16384;
+    var iter = storage.placements.iterator();
+    while (iter.next()) |entry| {
+        const p = entry.value_ptr;
+        switch (p.location) {
+            .virtual => {
+                has_virtual = true;
+                continue;
+            },
+            .relative => has_relative = true,
+            .pin => {},
+        }
+        const image = storage.images.getPtr(entry.key_ptr.image_id) orelse continue;
+        if (image.data.isPending()) continue;
+        const pos = graphics.computeViewportPos(p, image, t);
+        if (!pos.visible) continue;
+        var value = regular(t, p, image);
+        value.column = pos.col;
+        value.row = pos.row;
+        if (!visible(t, value)) continue;
+        if (used == output.len) return .out_of_space;
+        output[used] = value;
+        used += 1;
+    }
+    if (!has_virtual) {
+        count.* = used;
+        return .success;
+    }
+    var origins: [limit]Origin = undefined;
+    var origins_len: usize = 0;
+    const pages = &t.screens.active.pages;
+    const top = pages.getTopLeft(.viewport);
+    const bottom = pages.getBottomRight(.viewport) orelse return .invalid_value;
+    var virtuals = unicode.placementIterator(top, bottom);
+    while (virtuals.next()) |p| {
+        if (budget == 0) return .limit_exceeded;
+        budget -= 1;
+        const image = storage.images.getPtr(p.image_id) orelse continue;
+        if (image.data.isPending()) continue;
+        if (has_relative) origin: {
+            const target = storage.placeholderTarget(p.image_id, p.placement_id) orelse break :origin;
+            const vp = pages.pointFromPin(.viewport, p.pin) orelse break :origin;
+            for (origins[0..origins_len]) |*old| {
+                if (budget == 0) return .limit_exceeded;
+                budget -= 1;
+                if (std.meta.eql(old.key, target.key)) {
+                    old.x = @min(old.x, vp.viewport.x);
+                    old.y = @min(old.y, vp.viewport.y);
+                    break :origin;
+                }
+            }
+            if (origins_len == limit) return .limit_exceeded;
+            origins[origins_len] = .{ .key = target.key, .x = vp.viewport.x, .y = vp.viewport.y };
+            origins_len += 1;
+        }
+        const rp = p.renderPlacement(storage, image, t.width_px / t.cols, t.height_px / t.rows) catch continue;
+        const vp = pages.pointFromPin(.viewport, rp.top_left) orelse continue;
+        const value: RenderPlacement = .{
+            .image_id = image.id,
+            .column = @intCast(vp.viewport.x),
+            .row = @intCast(vp.viewport.y),
+            .offset_x = rp.offset_x,
+            .offset_y = rp.offset_y,
+            .pixel_width = rp.dest_width,
+            .pixel_height = rp.dest_height,
+            .source_x = rp.source_x,
+            .source_y = rp.source_y,
+            .source_width = rp.source_width,
+            .source_height = rp.source_height,
+            .z = -1,
+        };
+        if (!visible(t, value)) continue;
+        if (used == output.len) return .out_of_space;
+        output[used] = value;
+        used += 1;
+    }
+    if (has_relative) {
+        iter = storage.placements.iterator();
+        while (iter.next()) |entry| {
+            const p = entry.value_ptr;
+            const rel = switch (p.location) {
+                .relative => |rel| rel,
+                else => continue,
+            };
+            const chain = storage.resolveChain(rel) orelse continue;
+            if (chain.root.location != .virtual) continue;
+            const image = storage.images.getPtr(entry.key_ptr.image_id) orelse continue;
+            if (image.data.isPending()) continue;
+            for (origins[0..origins_len]) |origin| {
+                if (budget == 0) return .limit_exceeded;
+                budget -= 1;
+                if (!std.meta.eql(origin.key, chain.root_key)) continue;
+                var value = regular(t, p, image);
+                value.column = @as(i32, @intCast(origin.x)) +| chain.horizontal_offset;
+                value.row = @as(i32, @intCast(origin.y)) +| chain.vertical_offset;
+                if (!visible(t, value)) break;
+                if (used == output.len) return .out_of_space;
+                output[used] = value;
+                used += 1;
+                break;
+            }
+        }
+    }
+    count.* = used;
+    return .success;
+}
+
+pub fn tick(terminal_: tc.Terminal, now: u64, delay_: ?*u64) callconv(lib.calling_conv) Result {
+    if (comptime !options.kitty_graphics) return .no_value;
+    const wrapper = terminal_ orelse return .invalid_value;
+    const delay = delay_ orelse return .invalid_value;
+    const storage = &wrapper.terminal.screens.active.kitty_images;
+    if (storage.images.count() > limit) return .limit_exceeded;
+    delay.* = storage.animationTick(wrapper.io.io(), now) orelse return .no_value;
+    return .success;
+}
