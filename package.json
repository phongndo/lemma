{
  "name": "lemma",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @lemma/core build",
    "check": "pnpm build && node scripts/check-boundaries.ts && tsc -p scripts && pnpm lint && pnpm format:check && pnpm -r --workspace-concurrency=4 check",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm build && pnpm -r --workspace-concurrency=4 test",
    "start": "pnpm --filter @lemma/web build && pnpm --filter @lemma/host start",
    "lemma": "node --conditions=lemma-source apps/cli/src/main.ts",
    "dev": "node --conditions=lemma-source packages/host/scripts/dev.ts",
    "dev:desktop": "pnpm --filter @lemma/desktop dev",
    "dev:web": "pnpm --filter @lemma/web dev",
    "desktop": "pnpm --filter @lemma/desktop start",
    "example": "pnpm build && node packages/core/examples/hello.ts",
    "package:check": "node packages/core/scripts/check-package.ts",
    "browser:check": "node packages/core/scripts/check-package.ts --browser",
    "core:check": "pnpm --filter @lemma/core check",
    "core:test": "pnpm --filter @lemma/core test",
    "core:bench": "pnpm --filter @lemma/core bench",
    "core:stress": "node --expose-gc packages/core/bench/workload.ts",
    "sessions:bench": "pnpm --filter @lemma/plugin-sessions bench",
    "perf:check": "pnpm build && pnpm core:bench && pnpm core:stress && pnpm sessions:bench"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4"
}
