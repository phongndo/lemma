{
  "name": "lemma",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @lemma/core --filter @lemma/router build",
    "check": "pnpm build && node scripts/check-boundaries.ts && node scripts/size.ts && node scripts/examples-coverage.ts && tsc -p scripts && pnpm lint && pnpm format:check && pnpm -r --workspace-concurrency=4 check",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm build && vitest run",
    "ci": "pnpm check && pnpm test",
    "stress": "node scripts/stress.ts",
    "start": "pnpm --filter @lemma/web-app build && pnpm --filter @lemma/host start",
    "lemma": "node --conditions=lemma-source apps/cli/src/main.ts",
    "lemma:build": "pnpm --filter @lemma/cli-app build",
    "dev": "node --conditions=lemma-source packages/host/scripts/dev.ts",
    "dev:desktop": "pnpm --filter @lemma/desktop dev",
    "dev:web": "pnpm --filter @lemma/web-app dev",
    "desktop": "pnpm --filter @lemma/desktop start",
    "example": "pnpm build && node packages/core/examples/hello.ts",
    "package:check": "node packages/core/scripts/check-package.ts && node packages/router/scripts/check-package.ts",
    "browser:check": "node packages/core/scripts/check-package.ts --browser && node packages/router/scripts/check-package.ts --browser",
    "core:check": "pnpm --filter @lemma/core check",
    "core:test": "pnpm --filter @lemma/core test",
    "test:random": "pnpm build && pnpm core:test && pnpm --filter @lemma/sessions-files exec vitest run simulation && pnpm --filter @lemma/agent-loop exec vitest run conversation && pnpm --filter @lemma/sim exec vitest run world",
    "core:bench": "pnpm --filter @lemma/core bench",
    "core:stress": "node --expose-gc packages/core/bench/workload.ts",
    "sessions:bench": "pnpm --filter @lemma/sessions-files bench",
    "perf:check": "pnpm build && pnpm core:bench && pnpm core:stress && pnpm router:bench && pnpm sessions:bench && pnpm harness:bench",
    "router:bench": "pnpm --filter @lemma/router bench",
    "sim": "pnpm --filter @lemma/sim sim",
    "torture": "node --conditions=lemma-source scripts/torture.ts",
    "harness:bench": "node --expose-gc --conditions=lemma-source packages/sim/bench/harness.ts",
    "test:mutations": "node scripts/test-mutations.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.11.2"
}
