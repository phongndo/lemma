#!/usr/bin/env bash
set -euo pipefail

scripts/ci/configure debug \
  -DLEMMA_BUILD_TESTS=ON \
  -DLEMMA_BUILD_BENCHMARKS=OFF
cmake --build --preset debug --target lemma lemma_fast_test_binaries
scripts/ci/test debug
./build/debug/lemma --help >/dev/null
python3 scripts/ci/installed.py --build build/debug
