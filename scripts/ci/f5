#!/usr/bin/env bash
set -euo pipefail

readonly mode="${1:-smoke}"
readonly output_directory="build/release"

cleanup_ghostty_output() {
  rm -rf third_party/ghostty/zig-out
}
trap cleanup_ghostty_output EXIT

case "${mode}" in
  smoke)
    lifecycle_cycles=25
    benchmark_repetitions=1
    micro_repetitions=1
    micro_time=0.01s
    stress_mode=smoke
    qualification_soak_seconds=10
    reattach_cycles=3
    ;;
  extended)
    lifecycle_cycles=1000
    benchmark_repetitions=30
    micro_repetitions=10
    micro_time=0.2s
    stress_mode=extended
    qualification_soak_seconds=300
    reattach_cycles=30
    ;;
  *)
    printf 'usage: %s [smoke|extended]\n' "$0" >&2
    exit 2
    ;;
esac

mkdir -p "${output_directory}"
{
  hk validate &&
    nix flake check --no-build
} 2>&1 | tee "${output_directory}/f5-config-validation.log"
python3 -m py_compile \
  benchmarks/mux_benchmark.py \
  benchmarks/f5_compatibility.py \
  benchmarks/f5_soak.py
python3 benchmarks/benchmark_tools_test.py \
  >"${output_directory}/f5-benchmark-tools-tests.log"
python3 benchmarks/check_regression.py --validate-manifest

if [[ "${mode}" == extended ]]; then
  scripts/ci/format 2>&1 | tee "${output_directory}/f5-format.log"
  scripts/ci/lint 2>&1 | tee "${output_directory}/f5-clang-tidy.log"
  scripts/ci/lsp 2>&1 | tee "${output_directory}/f5-clangd.log"
  scripts/ci/workflows 2>&1 | tee "${output_directory}/f5-workflows.log"
fi

rm -rf third_party/ghostty/zig-out
scripts/ci/configure release \
  -DLEMMA_BUILD_TESTS=ON \
  -DLEMMA_BUILD_BENCHMARKS=ON \
  -DLEMMA_ENABLE_LATENCY_TRACE=OFF
cmake --build --preset release
# ShellCheck misreads this intentional Bash stderr-to-stdout pipeline as a logical operator.
# shellcheck disable=SC2266
scripts/ci/test release 2>&1 | tee "${output_directory}/f5-release-tests.log"

"${output_directory}/lemma_steady_state_allocation_audit" \
  | tee "${output_directory}/f5-steady-state-allocation-audit.json"
python3 -m json.tool "${output_directory}/f5-steady-state-allocation-audit.json" >/dev/null

python3 benchmarks/f5_compatibility.py \
  --output "${output_directory}/f5-compatibility.json" \
  >"${output_directory}/f5-compatibility.log"
scripts/ci/f5-stress release "${stress_mode}"

python3 benchmarks/mux_benchmark.py \
  --mode lifecycle-churn \
  --multiplexer lemma \
  --repetitions "${lifecycle_cycles}" \
  --output "${output_directory}/f5-lifecycle-${lifecycle_cycles}.json" \
  >"${output_directory}/f5-lifecycle-${lifecycle_cycles}.log"

"${output_directory}/lemma_benchmarks" \
  --benchmark_min_time="${micro_time}" \
  --benchmark_repetitions="${micro_repetitions}" \
  --benchmark_out="${output_directory}/f5-microbenchmarks.json" \
  --benchmark_out_format=json \
  >"${output_directory}/f5-microbenchmarks.log"
workload_failure_args=()
if [[ "${mode}" == extended ]]; then
  # Preserve an explicit JSON failure before the unchanged gate rejects it.
  workload_failure_args+=(--allow-workload-failures)
fi
python3 benchmarks/mux_benchmark.py \
  --mode comparison \
  --multiplexer lemma \
  --repetitions "${benchmark_repetitions}" \
  "${workload_failure_args[@]}" \
  --output "${output_directory}/f5-process-workloads-${benchmark_repetitions}.json" \
  >"${output_directory}/f5-process-workloads-${benchmark_repetitions}.log"
python3 benchmarks/mux_benchmark.py \
  --mode profiles \
  --multiplexer lemma \
  --repetitions "${benchmark_repetitions}" \
  --output "${output_directory}/f5-pane-profiles-${benchmark_repetitions}.json" \
  >"${output_directory}/f5-pane-profiles-${benchmark_repetitions}.log"

python3 - "${output_directory}/f5-pane-profiles-${benchmark_repetitions}.json" <<'PY'
import json
import sys
from pathlib import Path

path = Path(sys.argv[1])
report = json.loads(path.read_text(encoding="utf-8"))
profiles = report.get("pane_profiles")
if report.get("schema") != 4 or set(profiles or {}) != {"P1", "P4", "P16", "PMAX"}:
    raise SystemExit("F5 profile report is incomplete")
for profile, conditions in profiles.items():
    if set(conditions) != {"idle", "active"}:
        raise SystemExit(f"{profile} is missing idle/active evidence")
    for condition, result in conditions.items():
        resources = result.get("resources", {})
        interaction = result.get("interaction", {})
        required_samples = (
            resources.get("cpu_time", {}).get("samples_ns"),
            resources.get("rss", {}).get("samples_bytes"),
            resources.get("outer_bytes", {}).get("samples_bytes"),
            resources.get("outer_throughput", {}).get("samples_bytes_per_second"),
            interaction.get("key_to_pty", {}).get("samples_ns"),
            interaction.get("key_to_visible", {}).get("samples_ns"),
            interaction.get("client_bytes"),
        )
        if result.get("status") != "completed" or not all(required_samples):
            raise SystemExit(f"{profile}.{condition} lacks latency/CPU/bytes/throughput/memory")
        wakeups = resources.get("wakeups", {})
        if wakeups.get("available") is True:
            if not wakeups.get("samples_count"):
                raise SystemExit(f"{profile}.{condition} has no wakeup samples")
        elif not wakeups.get("reason"):
            raise SystemExit(f"{profile}.{condition} has no explicit wakeup outcome")
PY

scripts/ci/f5-soak release "${qualification_soak_seconds}" "${reattach_cycles}"

if [[ "${mode}" == extended ]]; then
  scripts/ci/sanitizers 2>&1 | tee "${output_directory}/f5-asan-ubsan-tests.log"
  scripts/ci/f5-stress sanitizers extended
  scripts/ci/f5-soak sanitizers "${qualification_soak_seconds}" "${reattach_cycles}"

  # Evaluate unchanged budgets last so a failure cannot suppress the other finite raw evidence.
  python3 benchmarks/check_regression.py \
    --micro-report "${output_directory}/f5-microbenchmarks.json" \
    --process-report "${output_directory}/f5-process-workloads-${benchmark_repetitions}.json" \
    --profile-report "${output_directory}/f5-pane-profiles-${benchmark_repetitions}.json" \
    --output "${output_directory}/f5-regression-budget.json" \
    >"${output_directory}/f5-regression-budget.log"
fi

python3 - "${mode}" "${lifecycle_cycles}" "${benchmark_repetitions}" <<'PY' \
  >"${output_directory}/f5-quality-summary.json"
import datetime
import json
import platform
import subprocess
import sys

commit = subprocess.run(
    ["git", "rev-parse", "HEAD"], check=True, capture_output=True, text=True
).stdout.strip()
dirty = bool(
    subprocess.run(
        ["git", "status", "--porcelain", "--untracked-files=normal"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout
)
print(json.dumps({
    "schema": 1,
    "suite": "f5-quality-summary",
    "status": "passed",
    "mode": sys.argv[1],
    "commit": commit,
    "worktree_dirty": dirty,
    "host": platform.node(),
    "system": platform.platform(),
    "completed_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "lifecycle_cycles": int(sys.argv[2]),
    "benchmark_repetitions": int(sys.argv[3]),
    "long_soaks_included": False,
    "long_soak_command": "scripts/ci/f5-soak <release|sanitizers> 86400 300",
}, indent=2, sort_keys=True))
PY

printf 'F5 %s evidence retained under %s/f5-*\n' "${mode}" "${output_directory}"
