#!/usr/bin/env bash
set -euo pipefail

readonly profile="${1:-release}"
readonly mode="${2:-smoke}"
readonly output_directory="build/release"

case "${profile}" in
  release|sanitizers) ;;
  *)
    printf 'usage: %s <release|sanitizers> [smoke|extended]\n' "$0" >&2
    exit 2
    ;;
esac
case "${mode}" in
  smoke) repetitions=2 ;;
  extended) repetitions=20 ;;
  *)
    printf 'usage: %s <release|sanitizers> [smoke|extended]\n' "$0" >&2
    exit 2
    ;;
esac

if [[ "${profile}" == sanitizers ]]; then
  leak_detection=1
  if [[ "$(uname -s)" == Darwin ]]; then
    leak_detection=0
  fi
  export ASAN_OPTIONS="detect_leaks=${leak_detection}:strict_string_checks=1"
  export UBSAN_OPTIONS="print_stacktrace=1:halt_on_error=1"
fi

mkdir -p "${output_directory}"
readonly filter='MuxProcessTest.SurvivesRapidResizeOutputFloodAndFocusedChildExit:MuxProcessTest.RejectsMalformedAndDisconnectingSetupAndReusesSlots:MuxProcessTest.RejectsVersionMismatchAndLiveMalformedPeerWithTypedReasons:MuxProcessTest.BackpressuresBlockedPtyAndRecoversInOrderWithoutStarvingPeers:MuxProcessTest.IdleAndNonreadingPeersCannotBlockAnotherSession:MuxProcessTest.LastShellExitReclaimsSessionAndRestoresTerminal'
readonly report="${output_directory}/f5-${profile}-stress-${mode}.json"
readonly log="${output_directory}/f5-${profile}-stress-${mode}.log"

rm -f "${report}" "${log}"
"./build/${profile}/lemma_e2e_tests" \
  --gtest_filter="${filter}" \
  --gtest_repeat="${repetitions}" \
  --gtest_output="json:${report}" 2>&1 | tee "${log}"

test -s "${report}"

blocked_reports=()
for (( iteration = 1; iteration <= repetitions; ++iteration )); do
  blocked_report="${output_directory}/f5-${profile}-blocked-client-${mode}-${iteration}.json"
  blocked_reports+=("${blocked_report}")
  python3 benchmarks/mux_benchmark.py \
    --mode blocked-client \
    --multiplexer lemma \
    --repetitions 1 \
    --allow-workload-failures \
    --server "build/${profile}/lemma_test_server" \
    --cli "build/${profile}/lemma_test_cli" \
    --peer "build/${profile}/lemma_test_pty_peer" \
    --output "${blocked_report}" >/dev/null
done
python3 - "${output_directory}/f5-${profile}-blocked-client-${mode}-summary.json" \
  "${blocked_reports[@]}" <<'PY'
import json
import sys
from pathlib import Path

output = Path(sys.argv[1])
reports = [json.loads(Path(path).read_text(encoding="utf-8")) for path in sys.argv[2:]]
workloads = [report.get("workloads", {}).get("blocked_client", {}) for report in reports]
if not workloads or any(workload.get("status") != "completed" for workload in workloads):
    raise SystemExit("one or more blocked-client stress repetitions failed")
disconnects = [int(workload["disconnect_latency_ns"]) for workload in workloads]
summary = {
    "schema": 1,
    "suite": "f5-blocked-client-stress",
    "status": "passed",
    "repetitions": len(reports),
    "raw_reports": [path for path in sys.argv[2:]],
    "disconnect_latency_ns": disconnects,
    "maximum_disconnect_latency_ns": max(disconnects),
}
output.write_text(json.dumps(summary, indent=2, sort_keys=True) + "\n", encoding="utf-8")
PY
