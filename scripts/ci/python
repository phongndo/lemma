#!/usr/bin/env bash
set -euo pipefail

readonly python_paths=(benchmarks scripts tools conanfile.py)

uv lock --check
uv run --locked ruff format --check "${python_paths[@]}"
uv run --locked ruff check "${python_paths[@]}"
uv run --locked ty check
uv run --locked python benchmarks/benchmark_tools_test.py >/dev/null
uv run --locked python -m unittest discover -s tools -p 'test_ci*.py'
