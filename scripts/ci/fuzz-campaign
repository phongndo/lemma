#!/usr/bin/env bash
set -euo pipefail

if [[ "$(uname -s)" != Linux ]]; then
  printf 'scheduled mutation fuzzing requires Linux libFuzzer\n' >&2
  exit 2
fi

readonly seconds_per_target="${LEMMA_FUZZ_CAMPAIGN_SECONDS_PER_TARGET:-300}"
if [[ ! "${seconds_per_target}" =~ ^[1-9][0-9]*$ ]] || ((seconds_per_target > 3600)); then
  printf 'LEMMA_FUZZ_CAMPAIGN_SECONDS_PER_TARGET must be in [1, 3600]\n' >&2
  exit 2
fi

rm -rf third_party/ghostty/zig-out build/sanitizers/fuzz-campaign
scripts/ci/validate-fuzz-corpus.py
scripts/ci/configure sanitizers \
  -DLEMMA_BUILD_TESTS=OFF \
  -DLEMMA_BUILD_BENCHMARKS=OFF \
  -DLEMMA_BUILD_FUZZERS=ON
cmake --build --preset sanitizers --target \
  lemma_attachment_decoder_fuzz lemma_host_input_parser_fuzz lemma_api_json_fuzz

readonly root="build/sanitizers/fuzz-campaign"
mkdir -p "${root}"/{work,artifacts}/{attachment,host-input,api}
cp -R fuzz/corpus/attachment/. "${root}/work/attachment/"
cp -R fuzz/corpus/host-input/. "${root}/work/host-input/"
cp -R fuzz/corpus/api/. "${root}/work/api/"

run_target() {
  local binary="$1"
  local domain="$2"
  local dictionary="$3"
  "${binary}" \
    "-max_total_time=${seconds_per_target}" \
    -timeout=10 \
    -rss_limit_mb=4096 \
    "-dict=${dictionary}" \
    "-artifact_prefix=${root}/artifacts/${domain}/" \
    "${root}/work/${domain}"
}

run_target ./build/sanitizers/lemma_attachment_decoder_fuzz attachment \
  fuzz/dictionaries/attachment.dict
run_target ./build/sanitizers/lemma_host_input_parser_fuzz host-input \
  fuzz/dictionaries/host-input.dict
run_target ./build/sanitizers/lemma_api_json_fuzz api fuzz/dictionaries/api-json.dict

printf 'scheduled fuzz campaign completed; evidence: %s\n' "${root}"
