#!/usr/bin/env bash
set -euo pipefail

scripts/ci/configure debug \
  -DLEMMA_BUILD_TESTS=ON \
  -DLEMMA_BUILD_BENCHMARKS=OFF
# Clangd needs Ghostty's generated public header but not Lemma object files.
cmake --build --preset debug --target zig_build_lib_vt

# check-clangd.sh disables check mode's per-token feature tests, so this lane can validate every
# production source/header without spending most of its time exercising hover and code actions.
find apps include src -type f \( -name '*.hpp' -o -name '*.cpp' \) -print0 |
  sort -z |
  xargs -0 -n 1 -P "${CLANGD_JOBS:-4}" cmake/check-clangd.sh
