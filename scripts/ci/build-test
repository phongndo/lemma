#!/usr/bin/env bash
set -euo pipefail

# Validate repository configuration independently from source analysis.
hk validate
nix flake check --no-build

scripts/ci/configure debug \
  -DLEMMA_BUILD_TESTS=ON \
  -DLEMMA_BUILD_BENCHMARKS=ON
cmake --build --preset debug
scripts/ci/test debug

# Exercise command dispatch without opening a PTY or creating persistent state.
./build/debug/lemma >/dev/null
