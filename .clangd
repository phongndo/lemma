CompileFlags:
  CompilationDatabase: build/debug
  Compiler: clang++

Diagnostics:
  ClangTidy:
    # Never put checks known to hurt interactive latency on the editor path.
    FastCheckFilter: Strict
    Add:
      - bugprone-*
      - cert-*
      - cppcoreguidelines-*
      - modernize-*
      - performance-*
      - portability-*
      - readability-*
    Remove:
      - bugprone-easily-swappable-parameters
      - cppcoreguidelines-avoid-magic-numbers
      - cppcoreguidelines-avoid-non-const-global-variables
      - cppcoreguidelines-owning-memory
      - modernize-use-trailing-return-type
      - readability-identifier-length
      - readability-magic-numbers
  UnusedIncludes: Strict
  Includes:
    # These dependencies expose deliberate umbrella headers. Their generated/platform-specific
    # implementation headers are not portable include targets, so keep Include Cleaner focused on
    # project and standard-library ownership.
    IgnoreHeader:
      - (bits|machine|malloc|sys)/.*
      - .*/_types/.*
      - ghostty/vt/.*
      - l(auxlib|ua|ualib)\.h
      - _?(signal|stdlib)\.h
  MissingIncludes: Strict

Hover:
  ShowAKA: true

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true
  Designators: true

Index:
  Background: Build
  StandardLibrary: Yes
