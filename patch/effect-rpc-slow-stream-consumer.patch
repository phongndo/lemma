+type SocketMessage = {
+  readonly _tag: string
+  readonly id?: string
+  readonly requestId?: string
+  readonly tag?: string
+}
+
+// A socket client whose server side is driven by hand. `receive` resolves once
+// the client's read loop is ready for the next frame.
+const makeSocketClient = Effect.gen(function*() {
+  const frames = yield* Queue.unbounded<string>()
+  const pulled = yield* Queue.unbounded<void>()
+  const sent = yield* Queue.unbounded<SocketMessage>()
+  const decoder = new TextDecoder()
+  const write = (data: string | Uint8Array | Socket.CloseEvent) =>
+    Effect.forEach(
+      (typeof data === "string" ? data : Socket.isCloseEvent(data) ? "" : decoder.decode(data))
+        .split("\n").filter((line) => line !== ""),
+      (line) => Queue.offer(sent, JSON.parse(line)),
+      { discard: true }
+    )
+  const socket = Socket.make({
+    reader: Effect.succeed({
+      pull: Queue.offer(pulled, void 0).pipe(
+        Effect.andThen(Queue.take(frames)),
+        Effect.map((frame) => [frame] as const)
+      ),
+      upgrade: Socket.SocketUpgradeError.unsupported
+    }),
+    writer: Effect.succeed({ write, writeAll: (all) => Effect.forEach(all, write, { discard: true }) })
+  })
+  const protocol = yield* RpcClient.makeProtocolSocket().pipe(
+    Effect.provideService(Socket.Socket, socket),
+    Effect.provide(RpcSerialization.layerNdjson)
+  )
+  const client = yield* RpcClient.make(TestGroup).pipe(Effect.provideService(RpcClient.Protocol, protocol))
+  yield* Queue.take(pulled)
+  const receive = (...messages: ReadonlyArray<object>) =>
+    Queue.offer(frames, messages.map((message) => JSON.stringify(message) + "\n").join("")).pipe(
+      Effect.andThen(Queue.take(pulled))
+    )
+  // Takes sent messages up to the next one with the given tag.
+  const next = (tag: string) =>
+    Effect.gen(function*() {
+      while (true) {
+        const message = yield* Queue.take(sent)
+        if (message._tag === tag) return message
+      }
+    })
+  const requestId = Effect.map(next("Request"), (message) => message.id!)
+  return { client, receive, next, requestId, sent }
+})
