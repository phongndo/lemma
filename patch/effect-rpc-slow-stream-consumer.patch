+  // The receive loop serves every request on the connection, so the part of a
+  // chunk that does not fit waits for its consumer in a fiber scoped to the
+  // request. The server sends the request's next chunk only after the Ack.
+  const offerChunk = (
+    requestId: RequestId,
+    entry: QueueEntry,
+    values: NonEmptyReadonlyArray<any>
+  ): Effect.Effect<void> =>
+    // uninterruptible from the mark below until the fiber that clears it exists
+    Effect.uninterruptibleMask((restore) => {
+      if (entries.get(requestId) !== entry) return Effect.void
+      // A server that sends before the Ack waits here, as before, rather than
+      // piling up a pending chunk per message.
+      if (entry.delivering !== undefined) {
+        return restore(Effect.andThen(entry.delivering.await, offerChunk(requestId, entry, values)))
+      }
+      const remaining = Queue.offerAllUnsafe(entry.queue, values)
+      if (remaining.length === 0) return restore(sendAck(requestId, entry))
+      // Marked in the same step as the values that fit, so an end that arrives
+      // before the fiber runs still waits for the rest.
+      const delivering = Latch.makeUnsafe(false)
+      entry.delivering = delivering
