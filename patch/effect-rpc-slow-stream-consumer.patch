+    Effect.suspend(() =>
+      // the request may have ended while its chunk waited for the consumer
+      entries.get(requestId) === entry
+        ? options.onFromClient({ message: { _tag: "Ack", requestId }, context: entry.context, discard: false })
+        : Effect.void
