amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Git hooks (https://hk.jdx.dev). `hk install` sets them up; see docs/development.md.
// The linters are the workspace's pinned versions, run through `pnpm exec`.
local linters = new Mapping<String, Step> {
  ["oxfmt"] = (Builtins.oxfmt) { prefix = List("pnpm", "exec") }
  ["oxlint"] = (Builtins.ox_lint) { prefix = List("pnpm", "exec") }
}

hooks {
  // Format and lint-fix the staged files; unstaged changes are stashed meanwhile.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  // CI's check and test jobs, before commits leave. It checks the working tree as it is, uncommitted changes
  // included. Without the repository variables git gives a hook: a test's `git init`, `config`, or `commit` in a
  // temporary directory would otherwise write this repository (its config, and a commit on the branch pushed).
  ["pre-push"] {
    steps {
      ["ci"] = new Step {
        check =
          "env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES -u GIT_QUARANTINE_PATH pnpm run ci"
      }
    }
  }
  // `hk check` and `hk fix` run the same steps by hand (all files with --all).
  ["check"] { steps = linters }
  ["fix"] {
    fix = true
    steps = linters
  }
}
