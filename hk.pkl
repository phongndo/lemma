amends "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.0.1/hk@2.0.1#/Builtins.pkl"

// Git hooks (https://hk.jdx.dev). `hk install` sets them up; see docs/development.md.
// The linters are the workspace's pinned versions, run through `pnpm exec`.
local linters = new Mapping<String, Step> {
  ["oxfmt"] = (Builtins.oxfmt) { prefix = List("pnpm", "exec") }
  ["oxlint"] = (Builtins.ox_lint) { prefix = List("pnpm", "exec") }
}

hooks {
  // Format and lint-fix the staged files; unstaged changes are stashed meanwhile.
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  // `hk check` and `hk fix` run the same steps by hand (all files with --all).
  ["check"] { steps = linters }
  ["fix"] {
    fix = true
    steps = linters
  }
}
