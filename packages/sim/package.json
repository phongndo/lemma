{
  "name": "@lemma/sim",
  "version": "0.1.0",
  "private": true,
  "description": "A deterministic simulator of the harness: the real plugins in simulated time, on a simulated disk, under faults drawn from a seed",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check": "tsrs --noEmit",
    "test": "vitest run",
    "sim": "node --conditions=lemma-source src/main.ts"
  },
  "dependencies": {
    "@lemma/agent": "workspace:*",
    "@lemma/agent-loop": "workspace:*",
    "@lemma/context-compaction": "workspace:*",
    "@lemma/context-prune": "workspace:*",
    "@lemma/contracts": "workspace:*",
    "@lemma/core": "workspace:*",
    "@lemma/llm": "workspace:*",
    "@lemma/sessions": "workspace:*",
    "@lemma/sessions-files": "workspace:*",
    "@lemma/testing": "workspace:*",
    "@lemma/tools": "workspace:*",
    "@lemma/tools-registry": "workspace:*",
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "vitest": "5.0.5"
  }
}
