{
  "name": "@lemma/router",
  "version": "0.1.0",
  "private": true,
  "description": "A client-side router whose routes can come and go at runtime, typed by each route's own definition",
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "lemma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsrs -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check": "tsrs --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "effect": "4.0.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsrs": "0.20.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
