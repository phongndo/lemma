{
  "name": "@lemma/testing",
  "version": "0.1.0",
  "private": true,
  "description": "Test support shared by Lemma's packages: a simulated disk for crash tests, contract conformance suites, and failure evidence",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./artifacts": "./src/artifacts.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lemma/contracts": "workspace:*",
    "@lemma/core": "workspace:*",
    "@lemma/sessions": "workspace:*",
    "effect": "4.0.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
