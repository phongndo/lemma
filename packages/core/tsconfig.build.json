{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "types": [],
    "lib": ["ES2022", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "noEmit": false,
    "noEmitOnError": true,
    "declaration": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"]
}
