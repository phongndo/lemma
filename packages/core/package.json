{
  "name": "@lemma/core",
  "version": "0.1.0",
  "private": true,
  "description": "Typed plugin composition, scoped lifecycles, hooks, events, and supervised reloads",
  "files": [
    "dist",
    "examples",
    "README.md",
    "DESIGN.md"
  ],
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "lemma-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plain": {
      "lemma-source": "./src/plain/index.ts",
      "types": "./dist/plain/index.d.ts",
      "import": "./dist/plain/index.js"
    },
    "./testing": {
      "lemma-source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./plain": {
        "types": "./dist/plain/index.d.ts",
        "import": "./dist/plain/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "import": "./dist/testing.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node bench/core.ts"
  },
  "dependencies": {
    "effect": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
