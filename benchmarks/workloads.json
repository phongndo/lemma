{
  "schema": 4,
  "suite": "core-mux-baseline",
  "terminal": {
    "columns": 80,
    "rows": 24,
    "term": "xterm-256color"
  },
  "pane_profiles": [
    {
      "id": "P1",
      "panes": 1,
      "purpose": "single interactive shell and steady-state overhead"
    },
    {
      "id": "P4",
      "panes": 4,
      "purpose": "ordinary development layout"
    },
    {
      "id": "P16",
      "panes": 16,
      "purpose": "heavy local workspace"
    },
    {
      "id": "PMAX",
      "panes": 64,
      "purpose": "per-session supported capacity"
    }
  ],
  "session_profiles": [
    {
      "id": "S1",
      "sessions": 1,
      "purpose": "one detached isolated workspace with one live shell"
    },
    {
      "id": "S4",
      "sessions": 4,
      "purpose": "ordinary concurrent isolated workspaces"
    },
    {
      "id": "S16",
      "sessions": 16,
      "purpose": "heavy concurrent isolated workspace set"
    }
  ],
  "workspace_profiles": [
    {
      "id": "W1",
      "workspaces": 1,
      "purpose": "one logical isolated workspace with one live shell"
    },
    {
      "id": "W4",
      "workspaces": 4,
      "purpose": "ordinary concurrent logical workspaces"
    },
    {
      "id": "W16",
      "workspaces": 16,
      "purpose": "heavy concurrent logical workspace set"
    }
  ],
  "session_profile_metrics": [
    "process_tree_cpu_time_ns",
    "process_tree_rss_bytes",
    "wakeups_when_supported",
    "direct_role_cpu_and_rss"
  ],
  "profile_conditions": {
    "idle": "all panes are live shells with no injected activity during resource sampling; focused-pane interaction is measured after the idle sample",
    "active": "the focused pane emits bounded continuous output from a one-millisecond input-aware poll deadline while resource and interaction samples are collected; all remaining panes stay live and idle"
  },
  "pane_profile_metrics": [
    "key_to_pty_ns",
    "key_to_outer_bytes_ns",
    "interaction_outer_bytes",
    "outer_bytes_per_one_second_sample",
    "outer_throughput_bytes_per_second",
    "process_tree_cpu_time_ns",
    "process_tree_rss_bytes",
    "wakeups_when_supported",
    "direct_role_cpu_and_rss"
  ],
  "process_workloads": [
    {
      "id": "warm_scroll",
      "input": "25000 79-column CRLF rows followed by a unique completion marker",
      "completion": "the marker is observable in the attached client output",
      "metrics": [
        "latency_ns",
        "outer_bytes"
      ],
      "cli_mode": "warm-scroll",
      "fixture": "warm-scroll",
      "subjects": [
        "direct",
        "lemma",
        "tmux",
        "zellij",
        "herdr"
      ],
      "completion_endpoint": "outer_bytes"
    },
    {
      "id": "attach_to_visible",
      "input": "attach a new physical client to a detached session whose canonical screen contains a unique marker",
      "completion": "the retained marker from the daemon's complete attach frame is observable in the outer client PTY",
      "metrics": [
        "latency_ns",
        "outer_bytes"
      ],
      "cli_mode": "attach-visible",
      "fixture": "attach-visible",
      "subjects": [
        "lemma",
        "tmux",
        "zellij",
        "herdr"
      ],
      "completion_endpoint": "outer_bytes"
    },
    {
      "id": "interactive_under_output",
      "input": "a same-pane peer emits bounded continuous output from a one-millisecond input-aware poll deadline while acknowledging and echoing unique input tokens",
      "completion": "each token is acknowledged from the PTY and observable in the attached client output",
      "metrics": [
        "key_to_pty_ns",
        "key_to_outer_bytes_ns",
        "outer_bytes"
      ],
      "cli_mode": "interactive-output",
      "fixture": "latency-output",
      "subjects": [
        "direct",
        "lemma",
        "tmux",
        "zellij",
        "herdr"
      ],
      "completion_endpoint": "pty_receipt_and_outer_bytes"
    },
    {
      "id": "interactive_open_loop",
      "input": "120 Hz independently scheduled unique input tokens with deterministic sub-frame jitter; the peer acknowledges and echoes every token without waiting for prior completion",
      "completion": "every scheduled token is acknowledged from the PTY and reaches the outer PTY byte stream",
      "metrics": [
        "key_to_pty_ns",
        "key_to_outer_bytes_ns",
        "schedule_lateness_ns"
      ],
      "cli_mode": "interactive-open-loop",
      "fixture": "latency",
      "subjects": [
        "direct",
        "lemma",
        "tmux",
        "zellij",
        "herdr"
      ],
      "completion_endpoint": "pty_receipt_and_outer_bytes"
    },
    {
      "id": "tui_redraw",
      "input": "an alternate-buffer peer acknowledges each unique input token and synchronously redraws the child PTY viewport minus its final autowrap row and column",
      "completion": "each token is acknowledged from the PTY and observable in the synchronized full-screen redraw",
      "metrics": [
        "key_to_pty_ns",
        "key_to_outer_bytes_ns",
        "outer_bytes"
      ],
      "cli_mode": "tui-redraw",
      "fixture": "latency-tui",
      "subjects": [
        "direct",
        "lemma",
        "tmux",
        "zellij",
        "herdr"
      ],
      "completion_endpoint": "pty_receipt_and_outer_bytes"
    },
    {
      "id": "tui_wheel_burst",
      "input": "64 normalized SGR wheel reports target one full-screen alternate-buffer peer with application mouse reporting enabled",
      "completion": "all 64 reports reach the PTY and the peer's synchronized redraw marker is observable",
      "metrics": [
        "key_to_pty_ns",
        "key_to_outer_bytes_ns",
        "outer_bytes"
      ],
      "cli_mode": "tui-wheel-burst",
      "fixture": "latency-tui-wheel",
      "subjects": [
        "direct",
        "lemma",
        "tmux",
        "zellij",
        "herdr"
      ],
      "completion_endpoint": "pty_receipt_and_outer_bytes"
    },
    {
      "id": "idle_resources",
      "input": "an attached quiescent native peer blocked indefinitely on input with no injected input or output for one second per sample",
      "completion": "the client and session remain attached for the complete sample interval",
      "metrics": [
        "daemon_cpu_time_ns",
        "daemon_rss_bytes",
        "attached_client_cpu_time_ns",
        "attached_client_rss_bytes",
        "process_tree_cpu_time_ns",
        "process_tree_rss_bytes",
        "wakeups_when_supported"
      ],
      "cli_mode": "idle-resources",
      "fixture": "idle-peer",
      "subjects": [
        "direct",
        "lemma",
        "tmux",
        "zellij",
        "herdr"
      ],
      "completion_endpoint": "bounded_resource_interval"
    },
    {
      "id": "component_resources",
      "input": "sample an empty daemon, one detached session, the same attached session, and the same session after detach",
      "completion": "each lifecycle state remains stable for every one-second resource sample",
      "metrics": [
        "baseline_daemon_rss_bytes",
        "detached_session_daemon_rss_bytes",
        "attached_session_daemon_rss_bytes",
        "detached_after_attach_daemon_rss_bytes"
      ],
      "cli_mode": "component-resources",
      "fixture": "component-lifecycle",
      "subjects": [
        "lemma"
      ],
      "completion_endpoint": "bounded_resource_interval"
    },
    {
      "id": "history_resources",
      "input": "25,000 fixed rows populate one attached 80x24 terminal whose history remains under the 50,000,000-byte per-pane quota",
      "completion": "the warm-scroll marker is visible before post-history resource sampling",
      "metrics": [
        "empty_process_tree_rss_bytes",
        "populated_process_tree_rss_bytes",
        "empty_daemon_rss_bytes",
        "populated_daemon_rss_bytes"
      ],
      "cli_mode": "history-resources",
      "fixture": "warm-scroll-history",
      "subjects": [
        "lemma"
      ],
      "completion_endpoint": "outer_bytes_and_resource_interval"
    },
    {
      "id": "lifecycle_churn",
      "input": "repeated create, attach, split to four panes, close to one pane, detach, and kill cycles",
      "completion": "the session and all pane children are reclaimed after every cycle",
      "metrics": [
        "daemon_rss_bytes_per_cycle",
        "process_tree_rss_bytes_per_cycle"
      ],
      "cli_mode": "lifecycle-churn",
      "fixture": "lifecycle-churn",
      "subjects": [
        "lemma"
      ],
      "completion_endpoint": "state_reclamation_and_resource_snapshot"
    },
    {
      "id": "blocked_pty",
      "input": "a gated peer receives and verifies a 2 MiB payload while another session echoes unique tokens",
      "completion": "the complete payload byte count and digest are rendered after the gate opens",
      "metrics": [
        "bytes_before_backpressure",
        "key_to_pty_ns",
        "key_to_outer_bytes_ns"
      ],
      "cli_mode": "blocked-pty",
      "fixture": "blocked-pty",
      "subjects": [
        "direct",
        "lemma",
        "tmux",
        "zellij",
        "herdr"
      ],
      "completion_endpoint": "pty_receipt_and_outer_bytes"
    },
    {
      "id": "blocked_client",
      "input": "a 500x200 non-reading attached client runs an unbounded pane-output flood while another session echoes unique tokens",
      "completion": "all peer tokens are visible and the non-reading client is disconnected by its no-progress deadline",
      "metrics": [
        "disconnect_latency_ns",
        "key_to_pty_ns",
        "key_to_outer_bytes_ns"
      ],
      "cli_mode": "blocked-client",
      "fixture": "blocked-client",
      "subjects": [
        "lemma"
      ],
      "completion_endpoint": "pty_receipt_and_outer_bytes"
    }
  ],
  "latency_trace": {
    "build_option": "LEMMA_ENABLE_LATENCY_TRACE",
    "runtime_variable": "LEMMA_LATENCY_TRACE",
    "trace_version": 2,
    "event_capacity_per_process": 32768,
    "event_bytes": 40,
    "overflow_policy": "retain the first bounded events and increment a dropped counter",
    "correlation_policy": "derive one bounded token from the exact _XXXXXXXX__ fixture suffix observed at client input, daemon input, PTY write, PTY output, frame, and outer-terminal boundaries; correlate client receive through the exact decoder-completing socket-read event",
    "clock": "CLOCK_MONOTONIC"
  },
